{
  "name": "@platform/tool-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./vite": {
      "types": "./vite/remote.d.ts",
      "default": "./vite/remote.mjs"
    }
  },
  "scripts": {
    "gen:types": "json2ts -i schema/tool-config.schema.json -o src/generated/tool-config.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@originjs/vite-plugin-federation": "1.3.6",
    "@platform/ui-kit": "workspace:*",
    "@rollup/plugin-yaml": "4.1.2",
    "@vitejs/plugin-react": "4.3.4"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "5.4.11"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "json-schema-to-typescript": "15.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
