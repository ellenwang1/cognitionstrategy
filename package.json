{
  "name": "cognition-internal-tools",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "preview": "turbo run preview --parallel",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run typecheck",
    "gen:types": "python3 scripts/export_config_schema.py && pnpm --filter @platform/tool-sdk run gen:types"
  },
  "devDependencies": {
    "json-schema-to-typescript": "15.0.3",
    "turbo": "2.3.3",
    "typescript": "5.6.3"
  }
}
